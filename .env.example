# Salin file ini menjadi .env.local, lalu ganti kedua nilainya.
ADMIN_PASSWORD=ganti-dengan-kata-sandi-yang-kuat
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang
# Express API lokal
API_PORT=4000
EXPRESS_API_URL=http://127.0.0.1:4000
